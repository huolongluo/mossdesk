# Required: Gemini Developer API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: use Vertex AI on Google Cloud instead of AI Studio
# GEMINI_PROVIDER=vertex
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GOOGLE_CLOUD_LOCATION=us-central1

# Model (default gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Public URL of this deployment (Cloud Run / custom domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Stripe — required for real revenue evidence
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Local JSON store (default ./.data)
# DATA_DIR=/tmp/mossdesk-data

# X Layer testnet (chain id 1952) — required for Build X AI Season
NEXT_PUBLIC_XLAYER_INVOICE_ADDRESS=
NEXT_PUBLIC_XLAYER_RPC_URL=https://testrpc.xlayer.tech/terigon
# Relayer that mints the receivable after Auditor ships (optional; wallet can issueAndPay)
XLAYER_PRIVATE_KEY=
XLAYER_RPC_URL=https://testrpc.xlayer.tech/terigon

# If Gemini returns "fetch failed" (common on networks that block Google),
# point Node at a local proxy such as Clash Verge:
# HTTPS_PROXY=http://127.0.0.1:7897
# HTTP_PROXY=http://127.0.0.1:7897
# MOSSDESK_PROXY=http://127.0.0.1:7897
