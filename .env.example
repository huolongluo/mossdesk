# Required: Gemini Developer API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: use Vertex AI on Google Cloud instead of AI Studio
# GEMINI_PROVIDER=vertex
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GOOGLE_CLOUD_LOCATION=us-central1

# Model (default gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Public URL of this deployment (Cloud Run / custom domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Stripe — required for real revenue evidence
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Local JSON store (default ./.data)
# DATA_DIR=/tmp/mossdesk-data
